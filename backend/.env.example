REAP_BASE_URL=https://sandbox.api.reap.global
REAP_ENROLLMENT_ID=
REAP_SIMULATE_CHECKOUT=COMPLETED
# Public HTTPS URL of this backend (Reap return URLs)
PUBLIC_URL=
APP_SCHEME=glance
# Market
SHOP_COUNTRY=SG
SHOP_CURRENCY=SGD
BUYER_EMAIL=demo@glance.app
SHIP_FIRST_NAME=Avery
SHIP_LAST_NAME=Tan
SHIP_PHONE=+6591234567
SHIP_LINE1=65 Mohamed Sultan Road
SHIP_CITY=Singapore
SHIP_STATE=Singapore
SHIP_POSTAL=239015
SHIP_COUNTRY=SG
# Vault (Kwal) — leave KWAL_SCRIPTS empty for the labelled mock
KWAL_SCRIPTS=
MOCK_VAULT_BALANCE_CENTS=25000
CARD_LAST4=
# Optional LLM for intent parsing (regex fallback otherwise)
LLM_API_KEY=
LLM_MODEL=
STATE_FILE=/tmp/glance-state.json
